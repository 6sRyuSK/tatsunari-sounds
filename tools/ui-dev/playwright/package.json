{
  "name": "@tatsunari-sounds/visage-ui-playwright",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright tooling for the local Visage WebAssembly UI development loop",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node doctor.js",
    "capture": "node verify.js --mode inspect",
    "test": "node verify.js --app all",
    "test:gallery": "node verify.js --app gallery",
    "test:rs": "node verify.js --app rs-editor",
    "test:tn-vocal-tuner": "node verify.js --app tn-vocal-tuner",
    "test:tn-equalizer": "node verify.js --app tn-equalizer"
  },
  "devDependencies": {
    "playwright": "1.61.0",
    "pngjs": "7.0.0"
  }
}
